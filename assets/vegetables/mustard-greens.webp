<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="mustardStem" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#DCEDC8"/>
      <stop offset="60%" stop-color="#AED581"/>
      <stop offset="100%" stop-color="#7CB342"/>
    </linearGradient>
    <linearGradient id="mustardLeaf" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#33691E"/>
      <stop offset="50%" stop-color="#558B2F"/>
      <stop offset="100%" stop-color="#7CB342"/>
    </linearGradient>
    <filter id="vegShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="18" stdDeviation="22" flood-color="#08210A" flood-opacity="0.42"/>
    </filter>
  </defs>

  <g filter="url(#vegShadow)">
    <!-- Central Stems Bunch -->
    <path d="M285,550 Q290,440 270,300 L330,300 Q310,440 315,550 Z" fill="url(#mustardStem)"/>
    <path d="M270,550 Q240,460 210,360 L240,350 Q270,440 290,550 Z" fill="url(#mustardStem)"/>
    <path d="M330,550 Q360,460 390,360 L360,350 Q330,440 310,550 Z" fill="url(#mustardStem)"/>

    <!-- Left Serrated Leaf -->
    <path d="M220,380 C160,340 120,280 110,210 C100,160 130,120 180,110 C230,100 270,140 280,200 C285,250 260,330 220,380 Z" fill="url(#mustardLeaf)"/>
    
    <!-- Right Serrated Leaf -->
    <path d="M380,380 C440,340 480,280 490,210 C500,160 470,120 420,110 C370,100 330,140 320,200 C315,250 340,330 380,380 Z" fill="url(#mustardLeaf)"/>

    <!-- Main Center Towering Leaf -->
    <path d="M300,320 C230,260 200,180 220,100 C235,50 280,30 300,30 C320,30 365,50 380,100 C400,180 370,260 300,320 Z" fill="#689F38"/>
    
    <!-- Crisp Leaf Ribs -->
    <path d="M300,320 L300,50" stroke="#DCEDC8" stroke-width="8" stroke-linecap="round"/>
    <path d="M300,220 Q250,180 230,130" stroke="#DCEDC8" stroke-width="4" stroke-linecap="round"/>
    <path d="M300,220 Q350,180 370,130" stroke="#DCEDC8" stroke-width="4" stroke-linecap="round"/>
    <path d="M300,150 Q260,110 240,80" stroke="#DCEDC8" stroke-width="3" stroke-linecap="round"/>
    <path d="M300,150 Q340,110 360,80" stroke="#DCEDC8" stroke-width="3" stroke-linecap="round"/>

    <!-- Dew Beads -->
    <circle cx="285" cy="180" r="7" fill="#FFFFFF" opacity="0.9"/>
    <circle cx="215" cy="160" r="6" fill="#FFFFFF" opacity="0.85"/>
    <circle cx="395" cy="150" r="6" fill="#FFFFFF" opacity="0.85"/>
  </g>
</svg>