<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <radialGradient id="malabarLeaf" cx="45%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#43A047"/>
      <stop offset="55%" stop-color="#1B5E20"/>
      <stop offset="100%" stop-color="#0D3813"/>
    </radialGradient>
    <linearGradient id="vineStem" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#7B1FA2"/>
      <stop offset="35%" stop-color="#388E3C"/>
      <stop offset="100%" stop-color="#81C784"/>
    </linearGradient>
    <filter id="malabarShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="18" stdDeviation="22" flood-color="#051C08" flood-opacity="0.45"/>
    </filter>
  </defs>

  <g filter="url(#malabarShadow)">
    <!-- Twisting Vine Stem -->
    <path d="M300,550 Q220,440 260,330 T340,200 Q370,120 320,60" fill="none" stroke="url(#vineStem)" stroke-width="14" stroke-linecap="round"/>

    <!-- Fleshy Heart-Shaped Leaf 1 (Bottom Left) -->
    <path d="M230,440 C140,430 90,360 110,290 C125,240 180,230 220,260 C250,280 270,350 230,440 Z" fill="url(#malabarLeaf)"/>

    <!-- Fleshy Heart-Shaped Leaf 2 (Center Right) -->
    <path d="M310,340 C370,260 450,260 480,310 C510,360 470,440 380,430 C320,420 300,370 310,340 Z" fill="url(#malabarLeaf)"/>

    <!-- Fleshy Heart-Shaped Leaf 3 (Top Left) -->
    <path d="M310,210 C240,160 230,90 270,50 C310,15 380,40 380,120 C380,170 340,210 310,210 Z" fill="url(#malabarLeaf)"/>

    <!-- Glossy Leaf Surface Sheen -->
    <path d="M140,290 Q170,255 200,275" stroke="#A5D6A7" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.6"/>
    <path d="M420,320 Q445,350 430,390" stroke="#A5D6A7" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.6"/>
    <path d="M290,80 Q325,60 345,95" stroke="#A5D6A7" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.6"/>

    <!-- Purple flower buds/berries -->
    <circle cx="340" cy="180" r="7" fill="#6A1B9A"/>
    <circle cx="355" cy="165" r="6" fill="#8E24AA"/>
    <circle cx="330" cy="80" r="5" fill="#AB47BC"/>

    <!-- Morning Dew Drops -->
    <circle cx="160" cy="330" r="8" fill="#FFFFFF" opacity="0.9"/>
    <circle cx="410" cy="350" r="7" fill="#FFFFFF" opacity="0.9"/>
    <circle cx="320" cy="120" r="6" fill="#FFFFFF" opacity="0.85"/>
  </g>
</svg>