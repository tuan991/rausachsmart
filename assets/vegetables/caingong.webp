<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <linearGradient id="ngongStem" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#C5E1A5"/>
      <stop offset="60%" stop-color="#7CB342"/>
      <stop offset="100%" stop-color="#33691E"/>
    </linearGradient>
    <linearGradient id="ngongLeaf" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#1B5E20"/>
      <stop offset="50%" stop-color="#2E7D32"/>
      <stop offset="100%" stop-color="#4CAF50"/>
    </linearGradient>
    <radialGradient id="yellowFlower" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFF59D"/>
      <stop offset="70%" stop-color="#FFEB3B"/>
      <stop offset="100%" stop-color="#FBC02D"/>
    </radialGradient>
    <filter id="caiShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="18" stdDeviation="22" flood-color="#08210A" flood-opacity="0.45"/>
    </filter>
  </defs>

  <g filter="url(#caiShadow)">
    <!-- Main Stalks -->
    <path d="M285,550 Q290,400 295,200 L315,200 Q310,400 315,550 Z" fill="url(#ngongStem)"/>
    <path d="M270,550 Q250,420 220,300 L245,290 Q275,410 290,550 Z" fill="url(#ngongStem)"/>
    <path d="M330,550 Q350,420 380,300 L355,290 Q325,410 310,550 Z" fill="url(#ngongStem)"/>

    <!-- Broad Emerald Leaves -->
    <path d="M220,380 C150,340 120,260 140,190 C180,140 240,170 260,240 C270,300 250,350 220,380 Z" fill="url(#ngongLeaf)"/>
    <path d="M380,380 C450,340 480,260 460,190 C420,140 360,170 340,240 C330,300 350,350 380,380 Z" fill="url(#ngongLeaf)"/>
    <path d="M300,320 C230,260 210,170 250,110 C290,60 330,80 340,140 C350,210 330,280 300,320 Z" fill="url(#ngongLeaf)"/>

    <!-- Leaf Veins -->
    <path d="M300,320 L295,120" stroke="#DCEDC8" stroke-width="5" stroke-linecap="round"/>
    <path d="M220,380 Q190,270 170,210" stroke="#DCEDC8" stroke-width="4" stroke-linecap="round"/>
    <path d="M380,380 Q410,270 430,210" stroke="#DCEDC8" stroke-width="4" stroke-linecap="round"/>

    <!-- Golden Yellow Blossom Clusters (Hoa cải vàng) -->
    <g fill="url(#yellowFlower)" stroke="#F57F17" stroke-width="1.5">
      <!-- Center head -->
      <circle cx="300" cy="110" r="14"/>
      <circle cx="285" cy="95" r="12"/>
      <circle cx="315" cy="95" r="12"/>
      <circle cx="300" cy="80" r="13"/>
      <circle cx="275" cy="115" r="11"/>
      <circle cx="325" cy="115" r="11"/>
      <!-- Flower buds -->
      <circle cx="290" cy="65" r="8" fill="#FFF59D"/>
      <circle cx="310" cy="65" r="8" fill="#FFF59D"/>
      <circle cx="300" cy="52" r="7" fill="#FFF9C4"/>
      
      <!-- Side shoot blossoms -->
      <circle cx="230" cy="180" r="10"/>
      <circle cx="218" cy="170" r="9"/>
      <circle cx="242" cy="170" r="9"/>

      <circle cx="370" cy="180" r="10"/>
      <circle cx="358" cy="170" r="9"/>
      <circle cx="382" cy="170" r="9"/>
    </g>

    <!-- Morning Dew Drops -->
    <circle cx="285" cy="160" r="6" fill="#FFFFFF" opacity="0.9"/>
    <circle cx="210" cy="240" r="6" fill="#FFFFFF" opacity="0.85"/>
    <circle cx="390" cy="240" r="6" fill="#FFFFFF" opacity="0.85"/>
  </g>
</svg>